{
	"name": "HERE Web Theming",
	"short_name": "WebTheming",
	"start_url": "./platform/provider.html",
	"display": "standalone",
	"background_color": "#fff",
	"description": "An example showing how to theme a HERE Core Web platform, its layout, views and the Web Notification Center.",
	"icons": [
		{
			"src": "common/images/here.png",
			"sizes": "72x72",
			"type": "image/png"
		}
	],
	"related_applications": [],
