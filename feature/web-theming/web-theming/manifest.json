		"platform": {
			"platformIdentifier": "web-theming-platform",
			"notificationServiceId": "web-theming-notification-service-channel",
			"interop": {
				"sharedWorkerUrl": "https://built-on-openfin.github.io/web-starter/feature/web-theming/web-theming/js/shared-worker.bundle.js",
				"brokerUrl": "https://built-on-openfin.github.io/web-starter/feature/web-theming/web-theming/platform/iframe-broker.html",
				"providerId": "web-interop",
				"defaultContextGroup": "green"
			},
			"layout": {
				"layoutContainerId": "layout_container",
				"defaultLayout": "https://built-on-openfin.github.io/web-starter/feature/web-theming/web-theming/layouts/default.layout.fin.json"
			}
		}
	}
}
